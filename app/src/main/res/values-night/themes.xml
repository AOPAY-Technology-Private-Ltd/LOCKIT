<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TheEmiClub" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorPrimary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/pink</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.TheEmiClub" parent="Base.Theme.TheEmiClub" />


    <style name="Theme.TheEmiClub.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>


    <style name="TabTextAutoResize" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">20sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">15sp</item>
        <item name="android:autoSizeMaxTextSize">16sp</item>
        <item name="android:autoSizeStepGranularity">4sp</item>
    </style>


    <style name="AppTheme.NoActionBar.FullScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Optional: Transparent system bars for edge-to-edge UI -->
        <item name="android:statusBarColor">@color/my_status_bar_color</item>
        <item name="android:navigationBarColor">@color/my_nav_bar_color</item>
    </style>



    <style name="Theme.TheEmiClub.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.TheEmiClub.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


    <style name="TransactionDetailItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">@dimen/_12sdp</item>
        <item name="android:paddingBottom">@dimen/_12sdp</item>
    </style>

    <style name="TransactionIcon">
        <item name="android:layout_width">@dimen/_24sdp</item>
        <item name="android:layout_height">@dimen/_24sdp</item>
        <item name="android:layout_marginEnd">@dimen/_8sdp</item>
        <item name="android:background">@drawable/bg_rounded_icon</item>
        <item name="android:padding">@dimen/_5sdp</item>
    </style>

    <style name="TransactionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#64748B</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="TransactionValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#1E293B</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:fontFamily">@font/inter_bold</item>
    </style>




</resources>