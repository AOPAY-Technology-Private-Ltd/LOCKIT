<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardUseCompatPadding="true"
        app:cardCornerRadius="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2.5"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:padding="@dimen/_5sdp">

                <LinearLayout
                    android:layout_weight="1.5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transaction ID: "
                            android:fontFamily="@font/inter_medium"
                            android:textSize="@dimen/_11ssp"
                            android:textColor="@color/black"/>

                        <TextView
                            android:id="@+id/transactionID"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PAY0000000057"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="@dimen/_11ssp"
                            android:textColor="@color/black"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/transactionmsg"
                        android:text="Your Account is debited by 100 Rs. Due to Pay Out on Account Number : 7894561230"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_9ssp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="@color/edittext_color"/>

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 Feb, 2026"
                        android:textColor="@color/grey"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/_10ssp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/transactionamount"
                    android:layout_weight="1"
                    android:text="- ₹100.00"
                    android:layout_width="0dp"
                    android:textAlignment="textEnd"
                    android:textSize="@dimen/_16ssp"
                    android:textColor="@color/red"
                    android:fontFamily="@font/inter_bold"
                    android:layout_height="wrap_content" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/reportstatuslayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/statushape"
                android:backgroundTint="@color/orange"
                android:layout_gravity="right"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/reportstatus"
                    android:gravity="right"
                    android:text="Pending"
                    android:fontFamily="@font/inter_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_10ssp"
                    android:textColor="@color/white" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>





    </androidx.cardview.widget.CardView>





</androidx.constraintlayout.widget.ConstraintLayout>