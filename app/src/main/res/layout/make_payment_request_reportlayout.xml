<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8FAFC">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="@dimen/_4sdp"
        app:strokeWidth="0dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:id="@+id/tvRecordStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_orange"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="● Pending"
                android:textColor="#D97706"
                android:textSize="@dimen/_10ssp" />

            <!-- Grid Data Section -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="4">

                <!-- Transaction No -->
                <LinearLayout style="@style/TransactionDetailItem">
                    <ImageView style="@style/TransactionIcon" android:src="@drawable/ic_hash" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/TransactionLabel" android:text="Transaction No." />
                        <TextView style="@style/TransactionValue" android:id="@+id/tvTransactionNo" android:text="AFT000054" />
                    </LinearLayout>
                </LinearLayout>

                <!-- UTR Number -->
                <LinearLayout style="@style/TransactionDetailItem">
                    <ImageView style="@style/TransactionIcon" android:src="@drawable/ic_card" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/TransactionLabel" android:text="UTR Number" />
                        <TextView style="@style/TransactionValue" android:id="@+id/tvUtrNumber" android:text="texn" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Request Date -->
                <LinearLayout style="@style/TransactionDetailItem">
                    <ImageView style="@style/TransactionIcon" android:src="@drawable/ic_calendar" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/TransactionLabel" android:text="Request Date &amp; Time" />
                        <TextView style="@style/TransactionValue" android:id="@+id/tvReqDate" android:text="2026-06-22 19:30" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Transaction Date -->
                <LinearLayout style="@style/TransactionDetailItem">
                    <ImageView style="@style/TransactionIcon" android:src="@drawable/ic_calendar" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/TransactionLabel" android:text="Transaction Date &amp; Time" />
                        <TextView style="@style/TransactionValue" android:id="@+id/tvTransDate" android:text="2026-06-22 19:30" />
                    </LinearLayout>
                </LinearLayout>


            </GridLayout>

            <!-- Bottom Amount Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F8FAFC"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardUseCompatPadding="true">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_2sdp">

                    <ImageView
                        android:id="@+id/walletIcon"
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_wallet" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_toEndOf="@id/walletIcon"
                        android:orientation="vertical">

                        <TextView style="@style/TransactionLabel"
                            android:text="Request Amount" />

                        <TextView
                            android:id="@+id/tvAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="₹1.50"
                            android:textColor="#0F172A"
                            android:textSize="@dimen/_18ssp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_receipt_blue" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>