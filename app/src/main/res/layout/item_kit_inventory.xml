<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingVertical="@dimen/_8sdp">

    <TextView
        android:id="@+id/tvMonthHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/grey"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="This Month"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvMonthHeader">

        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:background="@drawable/bg_rounded_icon"
            android:backgroundTint="#3B82F6"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="AM" />

        <TextView
            android:id="@+id/tvKitCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintStart_toEndOf="@+id/tvInitials"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="LK-7F2K-9XQ4" />

        <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/grey"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintEnd_toStartOf="@+id/llInstallation"
            app:layout_constraintStart_toStartOf="@+id/tvKitCode"
            app:layout_constraintTop_toBottomOf="@+id/tvKitCode"
            tools:text="Ronnit Mitra's Phone" />

        <TextView
            android:id="@+id/tvCustomerCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/grey"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintEnd_toStartOf="@+id/llInstallation"
            app:layout_constraintStart_toStartOf="@+id/tvKitCode"
            app:layout_constraintTop_toBottomOf="@+id/tvCustomerName"
            tools:text="Ronnit Mitra's Phone" />

        <LinearLayout
            android:id="@+id/llInstallation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Installed On"
                android:textColor="@color/grey"
                android:textSize="@dimen/_8ssp" />

            <TextView
                android:id="@+id/tvInstalledDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp"
                tools:text="24 June, 2026" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="@color/grey100"
            app:layout_constraintTop_toBottomOf="@+id/tvCustomerCode" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
