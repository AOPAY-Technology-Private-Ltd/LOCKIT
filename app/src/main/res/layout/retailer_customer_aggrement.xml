                android:background="@drawable/borderaggreement"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/imieno1"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:text="358419294596416"
                android:padding="@dimen/_4sdp"
                android:textSize="@dimen/_10ssp"
                android:background="@drawable/borderaggreement"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_weight=".1"
                android:layout_width="0dp"
                android:text="E"
                android:gravity="center"
                android:padding="@dimen/_4sdp"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"
                android:background="@drawable/borderaggreement"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_weight=".5"
                android:layout_width="0dp"
                android:text="IMIE 2 No"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"
                android:padding="@dimen/_4sdp"
                android:textSize="@dimen/_10ssp"
                android:layout_marginHorizontal="@dimen/_2sdp"
                android:background="@drawable/borderaggreement"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/imieno2"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:text="358419294596424"
                android:padding="@dimen/_4sdp"
                android:textSize="@dimen/_10ssp"
                android:background="@drawable/borderaggreement"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_weight=".1"
                android:layout_width="0dp"
                android:text="F"
                android:gravity="center"
                android:padding="@dimen/_4sdp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp"
                android:background="@drawable/borderaggreement"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_weight=".5"
                android:layout_width="0dp"
                android:text=" Phone No"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"
                android:padding="@dimen/_4sdp"
                android:textSize="@dimen/_10ssp"
                android:layout_marginHorizontal="@dimen/_2sdp"
                android:background="@drawable/borderaggreement"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/mobnumber"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:text="12345678900"
                android:padding="@dimen/_4sdp"
                android:textSize="@dimen/_10ssp"
                android:background="@drawable/borderaggreement"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_20sdp">

            <TextView
                android:layout_width="wrap_content"
                android:text="Thanking you,"
                android:textSize="@dimen/_13ssp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/companyname"
                android:layout_width="wrap_content"
                android:text="AO PAY"
                android:textSize="@dimen/_12ssp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>

        </LinearLayout>

         <TextView
             android:id="@+id/termconditiontxt"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:textColor="@color/black"
             android:layout_marginTop="@dimen/_10sdp"
             android:text="@string/delivery_terms_condition"/>

         <LinearLayout
             android:id="@+id/btnAccept"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Accept"
             android:layout_marginHorizontal="@dimen/_4sdp"
             android:layout_marginBottom="@dimen/_10sdp"
             android:textColor="@android:color/white"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             android:background="@drawable/searchbutton"
             android:gravity="center"
             android:padding="@dimen/_10sdp">

             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/inter_bold"
                 android:text="Accept"
                 android:textColor="@color/white"
                 android:textSize="@dimen/_14ssp" />

         </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>